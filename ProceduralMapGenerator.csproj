<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <!-- The xUnit test project lives under Tests/ and is built separately (Tests/Tests.csproj).
       Exclude it so the Godot game build doesn't try to compile the test sources. -->
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Scenes\" />
  </ItemGroup>
  <!-- DeprecatedCode/ holds source from the original version, kept for reference only. Exclude it so
       its classes (VoronoiDiagram, MapManager, ...) don't collide with or break the current build. -->
  <ItemGroup>
    <Compile Remove="DeprecatedCode/**/*.cs" />
  </ItemGroup>
</Project>
